# === Consola Next — copy to frontend/.env.local (never commit secrets) ===
# Qué rompe si falta: ver comentarios. Detalle: frontend/README.md
# Prod: docs/deploy-railway-vercel.md

# Auth.js — generate with: openssl rand -base64 32
# Missing → cookies/session cannot be signed.
AUTH_SECRET=replace-me
AUTH_TRUST_HOST=true
# On Vercel MUST be the public URL (https://….vercel.app). Missing → broken callbacks.
# AUTH_URL=http://localhost:3000

# Identity Postgres (separate DB from corpus). Same Compose instance, different database name.
# Create once: docker compose exec postgres psql -U "$POSTGRES_USER" -c "CREATE DATABASE entrega_lidr_auth;"
# Missing → login/register fail. Prod: Railway auth database URL.
AUTH_DATABASE_URL=postgresql://entrega:replace-me@localhost:5432/entrega_lidr_auth

# Google OAuth deferred — credentials (email/password) only for now.

# FastAPI origin for the BFF (server-only — never NEXT_PUBLIC_)
# Missing → BFF cannot reach the API. Prod: https://<railway-api>
AI_SERVICE_URL=http://localhost:8000

# Same value as backend SERVICE_TOKEN. Empty = FastAPI open mode (local/tests).
# NEVER prefix with NEXT_PUBLIC_ — the BFF attaches Bearer server-side.
# Mismatch with backend → every BFF call 401.
SERVICE_TOKEN=

# Optional non-interactive seed: npm run seed:admin -- admin@example.com
# AUTH_SEED_PASSWORD=
