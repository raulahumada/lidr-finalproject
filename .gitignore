# Local reference caches (never commit) — see openspec-prespec sync scripts
# - .reference/ai-engineering  → LIDR-academy/ai-engineering (course)
# - .reference/lidr-master     → cahumada/lidr-master (peer Knowledge CAG / answer)
.reference/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Env / secrets (never commit)
.env
.env.*
!**/.env.example

# Python
**/__pycache__/
**/.venv/
**/venv/
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Node / Next (frontend has its own; keep root safe)
**/node_modules/
**/.next/
**/out/

# Graphify knowledge graph output
graphify-out/
