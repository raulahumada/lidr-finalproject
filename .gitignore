# Local reference caches (never commit) — see openspec-prespec sync scripts
# - .reference/ai-engineering  → LIDR-academy/ai-engineering (course)
# - .reference/lidr-master     → cahumada/lidr-master (peer Knowledge CAG / answer)
.reference/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Env / secrets (never commit)
.env
.env.*
!**/.env.example

# Python
**/__pycache__/
**/.venv/
**/venv/
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Node / Next (frontend has its own; keep root safe)
**/node_modules/
**/.next/
**/out/

# Graphify knowledge graph output
graphify-out/

# Live eval harness reports (keep directory via .gitkeep)
backend/eval/reports/*.json

# OpenSpec pre-propose drafts — local only (never PR)
openspec/drafts/*
!openspec/drafts/README.md

backend/.railway-build-stamp
