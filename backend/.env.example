APP_NAME=Entrega LiDR API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Must match root Compose credentials (see repo-root `.env` / `.env.example`).
# Replace the password segment with the same POSTGRES_PASSWORD you put in root `.env`.
DATABASE_URL=postgresql+psycopg://entrega:replace-me@localhost:5432/entrega_lidr
# Required for POST /api/v1/search and the fixture seed / corpus ingest CLIs.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Absolute path to Metropol docs (never commit corpus files). Example:
# CORPUS_ROOT=/Users/you/Documents/Corpus/Metropol Fintech - Omnicanalidad (Agentes)
CORPUS_ROOT=
# Comma-separated allowlist (others are skipped).
CORPUS_EXTENSIONS=pdf,docx,txt,md
