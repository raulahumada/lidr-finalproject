APP_NAME=Entrega LiDR API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Must match root Compose credentials (see repo-root `.env` / `.env.example`).
# Replace the password segment with the same POSTGRES_PASSWORD you put in root `.env`.
DATABASE_URL=postgresql+psycopg://entrega:replace-me@localhost:5432/entrega_lidr
# Required for POST /api/v1/search, /answer, and the fixture seed / corpus ingest CLIs.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Allowlist for PUT /api/v1/config/models (runtime overrides; Redis). Embedding is not overridable.
AVAILABLE_CHAT_MODELS=gpt-4o-mini,gpt-4o
# Absolute path to Metropol docs (never commit corpus files). Example:
# CORPUS_ROOT=/Users/you/Documents/Corpus/Metropol Fintech - Omnicanalidad (Agentes)
CORPUS_ROOT=
# Comma-separated allowlist (others are skipped).
CORPUS_EXTENSIONS=pdf,docx,txt,md
# Redis Stack from root Compose (response CAG). Soft-fail if down.
REDIS_URL=redis://localhost:6379
ANSWER_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.92
# true = log similarity but never serve semantic hits (calibrate first).
SEMANTIC_CACHE_LOG_ONLY=true
ANSWER_PROMPT_VERSION=v2
ANSWER_DEFAULT_K=5
ANSWER_CONTEXT_MAX_TOKENS=3500
KNOWLEDGE_PACK_MAX_TOKENS=2048
# Agentic /answer/agentic: pause for human when confidence < threshold.
AGENTIC_CONFIDENCE_THRESHOLD=0.55
# Agentic LangGraph checkpointer: auto | postgres | memory.
# auto = Postgres when DATABASE_URL is set (pause/resume survives Uvicorn restart).
# memory = in-process only (tests / offline). Activity/progress log is always in-process.
AGENTIC_CHECKPOINTER=auto
# Conversation memory when agentic runs carry session_id (retrieve-first resolve).
CONVERSATION_MAX_TURNS=4
CONVERSATION_MEMORY_MAX_TOKENS=1024
# Star-topology orchestrator: max hub decisions before forcing the human gate.
AGENTIC_ORCHESTRATOR_MAX_STEPS=10
