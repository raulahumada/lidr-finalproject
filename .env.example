# Local Compose credentials (Postgres + pgAdmin). Copy to `.env` and edit.
# Never commit `.env`. Values here are placeholders — replace before `docker compose up`.

POSTGRES_USER=entrega
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=entrega_lidr

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-me

# Redis Stack (response CAG). Host-run API uses localhost; Compose service name is `redis`.
REDIS_URL=redis://localhost:6379
